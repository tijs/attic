# SwiftFormat configuration for Attic

--swiftversion 6.1
--minversion 0.55

# Rules
--enable sortImports
--enable redundantSelf
--enable trailingCommas
--enable blankLinesBetweenScopes
--enable consecutiveBlankLines

# Keep CI stable across SwiftFormat 0.61/0.62: these newer defaults would
# reformat pre-existing code not governed by Attic's style.
--disable wrapFunctionBodies
--disable wrapIfStatementBodies
--disable indent
--disable trailingSpace

# Formatting options
--indent 4
--indentcase false
--trimwhitespace always
--voidtype void
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--maxwidth 120
--commas always
--semicolons never
--stripunusedargs closure-only
--self remove
--header strip

# Exclusions
--exclude .build,Package.swift
